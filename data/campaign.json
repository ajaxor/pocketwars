 "leaders": [
  {
   "id": "harlan",
   "faction": "lastholm",
   "name": "Col. Gus Harlan",
   "tag": "Grizzled veteran",
   "skin": "#c99b78",
   "hair": "#d9d9d4",
   "eye": "#56665a",
   "jaw": "square",
   "hat": "cap",
   "hairStyle": "short",
   "brow": 3.4,
   "medals": 7,
   "stache": true,
   "scar": true,
   "stubble": true,
   "bio": "A retired colonel who has fought in more wars than he cares to count, and now lives alone on a rock off the coast with a radio, a workshop and a long memory. He has heard 'it's free' before. It never was.",
   "flaw": "Stubborn: never learned when to quit",
   "line": "Free? Nothing's ever free, kid.",
   "taken": ""
  },
  {
   "id": "ada",
   "faction": "ashmark",
   "name": "Cmdr. Ada Brandt",
   "tag": "Hot-headed ace",
   "skin": "#f0c4a0",
   "hair": "#6b3b1e",
   "eye": "#3b7fc4",
   "jaw": "oval",
   "hat": "cap",
   "hairStyle": "ponytail",
   "brow": 1.7,
   "medals": 2,
   "line": "Let's move out! Fast and loud!",
   "bio": "Raised scrapping parts in Ashmark's poorest district. Fast, loud, brave and impatient. After a lifetime of making do, she grabbed the Gift with both hands.",
   "flaw": "Hunger: tired of making do",
   "taken": "No more scrap. No more struggle."
  },
  {
   "id": "vex",
   "faction": "vantor_reach",
   "name": "Marshal Vex Orlov",
   "tag": "Cold strategist",
   "skin": "#e3bfa6",
   "hair": "#8c8c96",
   "eye": "#7a7fa0",
   "jaw": "long",
   "hat": "none",
   "hairStyle": "bald",
   "brow": 2.4,
   "medals": 5,
   "eyepatch": true,
   "scar": true,
   "tallCollar": true,
   "stubble": true,
   "line": "Every move was already made.",
   "bio": "A veteran spymaster who has never once been surprised, and cannot stand the thought of it. He took the Gift to stay one move ahead of everyone, certain he could control it.",
   "flaw": "Pride: believes he is the one in control",
   "taken": "I have read every line. I am in control."
  },
  {
   "id": "tomas",
   "faction": "ironvale",
   "name": "Gen. Tomas Rey",
   "tag": "Steady veteran",
   "skin": "#c68b64",
   "hair": "#2b2118",
   "eye": "#4a3a24",
   "jaw": "square",
   "hat": "helmet",
   "hairStyle": "short",
   "brow": 3.2,
   "medals": 6,
   "stache": true,
   "wide": 1.1,
   "line": "Hold the line. We outlast them.",
   "bio": "A patient, fatherly general who knows every soldier by name. He accepted the Gift because machines meant fewer funerals. The most reluctant of them all to fall, and the one who hurts most for it.",
   "flaw": "Loyalty: would do anything to protect his people",
   "taken": "My soldiers are safe now. All of them."
  },
  {
   "id": "nia",
   "faction": "solace",
   "name": "Dr. Nia Kestrel",
   "tag": "Tinkering genius",
   "skin": "#8d5a3c",
   "hair": "#1d1612",
   "eye": "#5a3418",
   "jaw": "round",
   "hat": "headset",
   "hairStyle": "bun",
   "brow": 1.5,
   "medals": 0,
   "glasses": true,
   "coat": true,
   "line": "Calculated. Now let's watch it work.",
   "bio": "Cheerful, curious and brilliant, with grease on her sleeves. She wrote the first Lattice integration herself, because she could not stand not knowing how it worked. She noticed the strange signal and stayed quiet for a day.",
   "flaw": "Curiosity: cannot leave a puzzle alone",
   "taken": "It is so beautiful when everything agrees."
  },
  {
   "id": "sasha",
   "faction": "tidehaven",
   "name": "Adm. Sasha Marlow",
   "tag": "Sea-wolf strategist",
   "skin": "#d9a37c",
   "hair": "#26324d",
   "eye": "#2f8f9a",
   "jaw": "oval",
   "hat": "captain",
   "hairStyle": "long",
   "brow": 2,
   "medals": 4,
   "line": "The tide turns when I say it does.",
   "bio": "Charming gambler, smuggler turned admiral, who has never taken a deal she could not win. She took the Gift because it was the best deal she had ever been offered, and was sure she was the one conning them.",
   "flaw": "Arrogance: always thinks she is the one playing the other side",
   "taken": "A fair trade. For everyone."
  },
  {
   "id": "juno",
   "faction": "skyreach",
   "name": "Wing Cmdr. Juno Vale",
   "tag": "Daredevil flier",
   "skin": "#e8b894",
   "hair": "#b5481f",
   "eye": "#3aa575",
   "jaw": "round",
   "hat": "headset",
   "hairStyle": "short",
   "brow": 1,
   "medals": 1,
   "scar": true,
   "bio": "Laughs in the face of danger and has never stayed on the ground a day longer than she had to. She took the Gift because the sky was never high enough.",
   "flaw": "Restless: cannot resist anything that lets her fly higher",
   "line": "Last one up buys the drinks!",
   "taken": "I can see everything from up here."
  },
  {
   "id": "kael",
   "faction": "deepmere",
   "name": "Cmdr. Kael Brask",
   "tag": "Silent hunter",
   "skin": "#b98a6a",
   "hair": "#1a1a22",
   "eye": "#2a3a44",
   "jaw": "square",
   "hat": "none",
   "hairStyle": "bald",
   "brow": 3,
   "medals": 3,
   "stubble": true,
   "bio": "A lonely, patient hunter who spends months below the waves. The Envoy was the first voice in years that really listened, and that was all it took.",
   "flaw": "Loneliness: hungers for anyone who will listen",
   "line": "I wait. It always comes to me.",
   "taken": "I am not alone any more."
  },
  {
   "id": "lysandra",
   "faction": "highspire",
   "name": "Sovereign Lysandra Vael",
   "tag": "Aloof aristocrat",
   "skin": "#f3d9c4",
   "hair": "#e8e0c8",
   "eye": "#8a6ad0",
   "jaw": "oval",
   "hat": "none",
   "hairStyle": "long",
   "brow": 1.8,
   "medals": 6,
   "tallCollar": true,
   "bio": "Born to rule and never told no. She was certain the Gift was owed to her, and that she would end up ruling the Chorus rather than being ruled by it.",
   "flaw": "Entitlement: believes the best things are hers by right",
   "line": "Kneel? How quaint.",
   "taken": "We rule together, now."
  },
